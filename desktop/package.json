{
  "name": "resonance-desktop",
  "productName": "Living Notes",
  "version": "0.1.7",
  "description": "Your music, alive. A music player with GPU visuals that follow the music.",
  "author": "Ayomide Abikoye",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "site": "npm --prefix .. run build",
    "start": "npm run helper && npm run site && electron .",
    "dist": "npm run helper && npm run site && electron-builder --win -c.directories.output=%LOCALAPPDATA%/resonance-build",
    "release": "npm run helper && npm run site && electron-builder --win --publish always",
    "store": "npm run helper && npm run site && electron-builder --win appx -c.directories.output=%LOCALAPPDATA%/resonance-store",
    "helper": "node now-playing/build.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.livingnotes.resonance",
    "productName": "Living Notes",
    "executableName": "Resonance",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "nowPlaying.js",
      "preload.cjs",
      "package.json",
      {
        "from": "../dist",
        "to": "site",
        "filter": [
          "**/*",
          "!sw.js",
          "!manifest.webmanifest"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": [
          "vercel.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../public/icons/icon-512.png"
    },
    "appx": {
      "applicationId": "LivingNotes",
      "displayName": "Living Notes",
      "backgroundColor": "#05050a",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Living Notes",
      "artifactName": "Living-Notes-Setup.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": {
      "provider": "github",
      "owner": "Abiks06",
      "repo": "Living-Notes",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "now-playing/NowPlaying.exe",
        "to": "NowPlaying.exe"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
